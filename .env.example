# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://arap:arap@localhost:5433/arap_dev
TEST_DATABASE_URL=postgresql://arap:arap@localhost:5434/arap_test

# ── API ───────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
LOG_LEVEL=info
APP_VERSION=0.1.0

# ── CORS / Frontend ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Real-time Gateway ─────────────────────────────────────
PORT=3001

# ── JWT / Authentication ──────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_TOKEN_EXPIRE_MINUTES=15

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
